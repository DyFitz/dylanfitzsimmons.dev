# Copy to .env for local development. Real environment variables take
# precedence over it.

# Optional locally; a fixed insecure key is used if unset.
# DJANGO_SECRET_KEY=

# SQLite by default. To use the Postgres container (docker compose up -d db):
# DATABASE_URL=postgres://site:site@localhost:5432/site

SITE_URL=http://localhost:8000
SITE_SOURCE_URL=https://github.com/DyFitz/dylanfitzsimmons.dev

LOG_LEVEL=INFO

# The contact form. Locally, emails are printed to the console instead of sent.
# CONTACT_EMAIL=contact@dylanfitzsimmons.dev
# DJANGO_DEFAULT_FROM_EMAIL=website@dylanfitzsimmons.dev

# Production only: the mail server that sends them.
# SMTP_HOST=
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Production only, behind the hosting platform's proxy: the header it puts the visitor's
# IP address in, used by the contact form's rate limit.
# DJANGO_CLIENT_IP_HEADER=HTTP_X_FORWARDED_FOR
